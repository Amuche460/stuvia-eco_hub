{
  "name": "Payment",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string",
      "description": "Reference to student"
    },
    "student_name": {
      "type": "string",
      "description": "Student full name"
    },
    "student_level": {
      "type": "string",
      "description": "Student level"
    },
    "student_reg_no": {
      "type": "string",
      "description": "Student reg number"
    },
    "student_matric_no": {
      "type": "string",
      "description": "Student matric number"
    },
    "type": {
      "type": "string",
      "enum": [
        "dues",
        "donation"
      ],
      "description": "Payment type"
    },
    "amount": {
      "type": "number",
      "description": "Payment amount in Naira"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "bank_transfer"
      ],
      "description": "Payment method"
    },
    "proof_url": {
      "type": "string",
      "description": "URL to uploaded proof of payment"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "verified",
        "rejected"
      ],
      "default": "pending",
      "description": "Payment verification status"
    },
    "receipt_number": {
      "type": "string",
      "description": "Auto-generated receipt number"
    },
    "verified_by": {
      "type": "string",
      "description": "Admin who verified"
    },
    "verified_at": {
      "type": "string",
      "description": "Verification timestamp"
    },
    "rejection_reason": {
      "type": "string",
      "description": "Reason for rejection if applicable"
    }
  },
  "required": [
    "student_name",
    "type",
    "amount"
  ]
}