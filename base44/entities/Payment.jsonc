{
  "name": "Payment",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string",
      "description": "Reference to student"
    },
    "student_name": {
      "type": "string",
      "description": "Student full name"
    },
    "student_level": {
      "type": "string",
      "description": "Student level"
    },
    "student_reg_no": {
      "type": "string",
      "description": "Student reg number"
    },
    "student_matric_no": {
      "type": "string",
      "description": "Student matric number"
    },
    "academic_session": {
      "type": "string",
      "description": "September-to-August dues cycle, e.g. 2026/2027"
    },
    "type": {
      "type": "string",
      "enum": [
        "dues",
        "donation"
      ],
      "description": "Payment type"
    },
    "amount": {
      "type": "number",
      "description": "Payment amount in Naira"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "bank_transfer",
        "cash"
      ],
      "description": "Payment method"
    },
    "proof_url": {
      "type": "string",
      "description": "URL to uploaded proof of payment"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "verified",
        "rejected"
      ],
      "default": "pending",
      "description": "Payment verification status"
    },
    "receipt_number": {
      "type": "string",
      "description": "Auto-generated receipt number"
    },
    "verified_by": {
      "type": "string",
      "description": "Who or what verified the payment"
    },
    "verified_at": {
      "type": "string",
      "description": "Verification timestamp"
    },
    "rejection_reason": {
      "type": "string",
      "description": "Reason for rejection if applicable"
    },
    "receipt_data": {
      "type": "object",
      "description": "Data extracted from the uploaded receipt by AI",
      "properties": {
        "amount": {
          "type": "number"
        },
        "date": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "bank_name": {
          "type": "string"
        },
        "account_number": {
          "type": "string"
        },
        "account_name": {
          "type": "string"
        },
        "sender_name": {
          "type": "string"
        }
      }
    },
    "validation_errors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Compliance errors found during validation"
    }
  },
  "required": [
    "student_name",
    "type",
    "amount"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}