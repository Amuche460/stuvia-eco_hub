{
  "name": "Staff",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "description": "Must end with @cu.edu.ng"
    },
    "department": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "otp_code": {
      "type": "string"
    },
    "otp_expiry": {
      "type": "string"
    },
    "is_verified": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "full_name",
    "email"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": null,
    "delete": null
  }
}