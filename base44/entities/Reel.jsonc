{
  "name": "Reel",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Hook/headline that captures attention"
    },
    "content": {
      "type": "string",
      "description": "Main educational content body"
    },
    "key_takeaways": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Key bullet points students should remember"
    },
    "did_you_know": {
      "type": "string",
      "description": "A surprising, thought-provoking fact"
    },
    "topic": {
      "type": "string",
      "enum": [
        "Finance",
        "Economics",
        "Nigeria Economy",
        "Geopolitics",
        "Purpose",
        "Mindset",
        "Faith"
      ],
      "description": "Content category"
    },
    "creator": {
      "type": "string",
      "description": "Content source label"
    },
    "order": {
      "type": "number",
      "default": 0,
      "description": "Display order"
    }
  },
  "required": [
    "title",
    "content",
    "topic"
  ]
}